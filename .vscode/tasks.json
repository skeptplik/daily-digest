{
  "version": "2.0.0",
  "inputs": [
    { "id": "otherDigest", "type": "promptString", "description": "Путь к JSON другой модели, например data/experiments/chatgpt-2026-11-02.json" }
  ],
  "tasks": [
    {
      "label": "Digest: собрать демо-страницу (без сети)",
      "type": "shell",
      "command": "python scripts/render.py",
      "options": { "env": { "NO_NETWORK": "1", "PLACEHOLDER_IMAGES": "1", "PYTHONUTF8": "1" } },
      "problemMatcher": []
    },
    {
      "label": "Digest: проверить digest.json",
      "type": "shell",
      "command": "python -m json.tool data/digest.json",
      "options": { "env": { "PYTHONUTF8": "1" } },
      "problemMatcher": []
    },
    {
      "label": "Digest: сравнить дайджест другой модели (укажите путь к файлу)",
      "type": "shell",
      "command": "python scripts/validate.py ${input:otherDigest}; python scripts/render.py",
      "options": { "env": { "DIGEST_FILE": "${input:otherDigest}", "PYTHONUTF8": "1" } },
      "problemMatcher": []
    },
    {
      "label": "Digest: собрать заголовки (RSS, нужен интернет)",
      "type": "shell",
      "command": "python scripts/collect.py",
      "options": { "env": { "PYTHONUTF8": "1" } },
      "problemMatcher": []
    }
  ]
}
